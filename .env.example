APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Halimun Highland"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MIDTRANS_SERVER_KEY and MIDTRANS_CLIENT_KEY are required when PAYMENT_GATEWAY=midtrans.
# With an empty server key every Midtrans call and webhook is rejected.
PAYMENT_GATEWAY=manual
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Access control. See docs/internal/05-access-security-ops.md
# Shared password for the demo accounts created by db:seed in local/testing only. Never used in production.
DEMO_PASSWORD=
# Optional: read by php artisan app:create-owner instead of prompting (min 12 characters).
OWNER_PASSWORD=
# Force owner accounts to enroll authenticator-app 2FA. Defaults to true when APP_ENV=production.
OWNER_2FA_REQUIRED=

# Reverse proxy, backups and health checks. Production values: .env.production.example
TRUSTED_PROXIES=127.0.0.1,::1
BOOKING_HOLD_MINUTES=120
BOOKING_PROOF_REVIEW_HOURS=24
BACKUP_RETENTION_DAYS=14
# Off-server copy: name of a filesystem disk, e.g. s3 (any S3-compatible storage, AWS_* keys below). Empty keeps local only.
BACKUP_DISK=
BACKUP_DISK_DIRECTORY=database-backups
BACKUP_RUN_AT=02:30
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# WhatsApp notifications (FR-36). Nothing is sent while WHATSAPP_ENABLED=false.
# Driver: log (masked log line only) or fonnte (needs WHATSAPP_FONNTE_TOKEN, billed per message by the provider).
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_FONNTE_TOKEN=

# Contact details shown on the landing page (client answer, 10 Oct 2026).
SITE_ADDRESS="Jl. Joglo RT 3 RW 5 No. 88, Cibeureum, Cisarua, Bogor, Jawa Barat"
SITE_WHATSAPP_NUMBER=6282191555887
SITE_MAPS_URL=https://share.google/vJMxR52kojoLf4o0z
SITE_INSTAGRAM_URL=https://www.instagram.com/halimunhighland
SITE_TIKTOK_URL=https://www.tiktok.com/@halimun.highland7

# Bank account guests transfer to. Leave empty until the owner confirms; the payment page then asks guests to contact admin.
SITE_BANK_NAME=
SITE_BANK_ACCOUNT_NUMBER=
SITE_BANK_ACCOUNT_HOLDER=

# Fingerprint log file (CSV or ZKTeco attlog.dat) read nightly by SyncFingerprintLogs.
# Empty means the nightly sync only logs a skip; manual import from the Absensi page still works.
ATTENDANCE_FINGERPRINT_ENABLED=false
ATTENDANCE_LOG_PATH=
