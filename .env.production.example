# Production profile for the 2 vCPU / 4 GB Ubuntu VPS (Nginx + PHP-FPM 8.3 + MySQL 8).
# Copy to .env on the server, fill every CHANGE_ME, then: php artisan key:generate --force
# Never commit the filled file. Step by step guide: docs/DEPLOY.md

APP_NAME="Raynad Camping"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US
# APP_PREVIOUS_KEYS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Reverse proxy. Comma separated IPs whose X-Forwarded-* headers are trusted.
# Nginx on the same host: keep the default. Behind a CDN or load balancer: list its IPs, or * if the
# origin is reachable only through it.
TRUSTED_PROXIES=127.0.0.1,::1

# Logging: one file per day, 14 days kept, warnings and above only.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=8

# Database (MySQL 8). Create a dedicated user with privileges on this schema only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raynad_camping
DB_USERNAME=raynad
DB_PASSWORD=CHANGE_ME
# DB_SOCKET=
# DB_URL=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

# Session, cache and queue. Default: database drivers, no extra service needed.
# Redis option (recommended with 4 GB RAM, apt install redis-server php8.3-redis): set
#   SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis
# and fill the REDIS_* block. No code change is needed. Queue worker: deploy/supervisor-queue.conf
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_TABLE=sessions

CACHE_STORE=database
CACHE_PREFIX=raynad_
# DB_CACHE_CONNECTION=
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# DB_CACHE_TABLE=
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default

QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_CONNECTION=
# DB_QUEUE=default
# DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

REDIS_CLIENT=phpredis
# REDIS_URL=
REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=2000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Mail (placeholders, used for staff password resets if enabled).
MAIL_MAILER=smtp
MAIL_SCHEME=null
# MAIL_URL=
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_LOG_CHANNEL=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# Payment. The webhook URL to register in the Midtrans dashboard is APP_URL/webhook/payment
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=CHANGE_ME
MIDTRANS_CLIENT_KEY=CHANGE_ME
MIDTRANS_IS_PRODUCTION=true

# Booking rules (the tax_rate row in the settings table overrides BOOKING_TAX_RATE).
BOOKING_HOLD_MINUTES=15
BOOKING_TAX_RATE=0.11

# Public site details shown on the landing page and invoices. WhatsApp: 628123456789 (no plus).
SITE_WHATSAPP_NUMBER=CHANGE_ME
SITE_ADDRESS=CHANGE_ME
SITE_MAPS_URL=CHANGE_ME
SITE_INSTAGRAM_URL=CHANGE_ME

# Access control. OWNER_PASSWORD is only for the one-off app:create-owner run, unset it afterwards.
# DEMO_PASSWORD is never used in production.
OWNER_2FA_REQUIRED=true
OWNER_PASSWORD=
DEMO_PASSWORD=

# Database backup (php artisan app:backup-database, daily 02:30, schedule in routes/console.php).
# BACKUP_DISK is the off-server copy: name of a filesystem disk (s3, sftp). Leave empty for local only.
BACKUP_RETENTION_DAYS=14
BACKUP_DISK=
BACKUP_DISK_DIRECTORY=database-backups
BACKUP_RUN_AT=02:30
BACKUP_TIMEOUT_SECONDS=600
MYSQLDUMP_BINARY=mysqldump

# Thresholds for php artisan app:health
HEALTH_MAX_FAILED_JOBS=0
HEALTH_MAX_QUEUE_WAIT_SECONDS=300

# Only when BACKUP_DISK points at an s3 disk (composer require league/flysystem-aws-s3-v3 "^3.0")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
